# OpenRouter (required)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://arnav
OPENROUTER_APP_NAME=arnav
OPENROUTER_USER=arnav
OPENROUTER_TRACE_APP_NAME=arnav

# Prompt caching (required)
# auto: let OpenRouter/providers cache automatically
# explicit: add explicit cache breakpoints to long prompt sections
OPENROUTER_PROMPT_CACHE_STRATEGY=auto
OPENROUTER_PROMPT_CACHE_MIN_CHARS=1200

OPENROUTER_MODELS_SPEC=minimax/minimax-m2.5:nitro
OPENROUTER_MODELS_ARCHITECT=minimax/minimax-m2.5:nitro
OPENROUTER_MODELS_SCAFFOLD=minimax/minimax-m2.5:nitro
OPENROUTER_MODELS_CODER=minimax/minimax-m2.1:nitro
OPENROUTER_MODELS_CODER_LENGTH_FALLBACK=qwen/qwen3-coder
OPENROUTER_MODELS_REPAIR_PRIMARY=minimax/minimax-m2.5:nitro
OPENROUTER_MODELS_REPAIR_ESCALATION=minimax/minimax-m2.5:nitro
OPENROUTER_MODELS_QA=minimax/minimax-m2.5:nitro
OPENROUTER_MODELS_FINALIZE=minimax/minimax-m2.5:nitro

# Reasoning-enabled phases (required; comma-separated)
OPENROUTER_REASONING_PHASES=spec,architect,qa,repair_escalation

DEXTER_SKELETON_AUTOFIX_PASSES=1
DEXTER_FIX_DAG_MAX_PASSES=2
DEXTER_BUILD_CACHE_ENABLED=true
DEXTER_ENABLE_STARTER_TEMPLATES=false
DEXTER_ENABLE_SKELETON_VALIDATION=true
DEXTER_ENABLE_FINAL_VALIDATION=true
DEXTER_ENABLE_QA=true
DEXTER_ENABLE_FIX_DAG=true
